# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Your app's Client ID from https://developer.spotify.com/dashboard -> your app -> Settings.
# There is no client secret here, on purpose: the app logs in with the PKCE flow,
# which is designed for apps that run in the browser and can't keep a secret.
VITE_SPOTIFY_CLIENT_ID=


# Optional: radio, Daily Mixes, Discover Weekly and "Fans also like".
# Get a free API key at https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=
