# Copy this file to .env and fill in your values. .env is git-ignored.

# --- Anthropic (required) ---
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the agent. Defaults to Claude Sonnet 5.5.
ASSISTANT_MODEL=claude-sonnet-5-5

# How hard the model thinks before answering: low | medium | high | xhigh | max.
# medium is a good balance for multi-step tool use; low is faster/cheaper for chat.
ASSISTANT_EFFORT=medium

# Max rounds of tool calls per request before the agent is forced to answer.
MAX_TOOL_ITERATIONS=10

# If Claude's safety classifier declines a request, retry it server-side on a
# fallback model instead of returning a refusal. Set to false to disable.
ASSISTANT_REFUSAL_FALLBACK=true

# --- Spotify (optional; leave blank to run without music tools) ---
# From your app at https://developer.spotify.com/dashboard -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must EXACTLY match a Redirect URI in the dashboard. Spotify rejects "localhost";
# use the loopback IP 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Where the Spotify login token is cached (git-ignored).
SPOTIFY_CACHE_PATH=.spotify_cache

# --- Safety ---
# Playlist changes with more than this many tracks show a preview and need y/n.
# 0 = confirm every playlist change.
PLAYLIST_CONFIRM_THRESHOLD=10

# --- User context ---
USER_TIMEZONE=Europe/London

# --- Logging ---
LOG_LEVEL=WARNING
